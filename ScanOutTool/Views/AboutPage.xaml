<Page x:Class="ScanOutTool.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About"
      Background="{DynamicResource MaterialDesignPaper}">
    <Page.Resources>
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="TitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Scan Out Tool" Style="{StaticResource TitleStyle}"/>
                    <TextBlock Text="Version 1.0.4.4" Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="Dashboard vận hành scan out, rescan, kiểm tra RF/HMES block, gửi dữ liệu lên HMES và theo dõi kết quả ShopFloor." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="Chrome chạy nền bằng Selenium. Dashboard chỉ hiển thị dữ liệu cần thiết để operator thao tác trên một màn hình." Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Luồng Xử Lý" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="1. Nhận PID từ scanner." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="2. Xử lý mã đặc biệt như CHOOSE, TRACE, CLEAR." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="3. Kiểm tra RF block. Nếu có block thì dừng trước ShopFloor." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="4. Kiểm tra HMES block. Nếu reason có Xray thì dừng trước ShopFloor." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="5. Đọc kết quả ShopFloor, validate DB, gửi web HMES theo run mode." Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Run Mode" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="ScanOut_Rescan: chạy đủ luồng ShopFloor, database và HMES web." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="ScanOutOnly: chỉ scan out và validate database, không gửi HMES web." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="RescanOnly: không gửi PID sang ShopFloor, chỉ gửi trực tiếp lên HMES web sau khi pass block check." Style="{StaticResource BodyTextStyle}"/>
                        <TextBlock Text="None: dùng khi cần tạm dừng xử lý tự động." Style="{StaticResource BodyTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Hướng Dẫn Cài Đặt" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="1. Cài Google Chrome đúng phiên bản tương thích ChromeDriver đi kèm." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="2. Vào Settings, nhập Server IP của HMES/Database." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="3. Chọn đúng ShopFloor EXE Path để tool có thể mở lại ShopFloor khi Start." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="4. Chọn ShopFloor Log Folder nếu cần đọc log hoặc debug dữ liệu scan." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="5. Cấu hình Scanner Port là cổng COM nhận dữ liệu từ scanner." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="6. Cấu hình ShopFloor Port là cổng COM ảo gửi dữ liệu sang ShopFloor." Style="{StaticResource BodyTextStyle}"/>
                    <TextBlock Text="7. Kiểm tra Work Order Mode theo line đang chạy, sau đó Save và quay lại Dashboard nhấn START." Style="{StaticResource BodyTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
