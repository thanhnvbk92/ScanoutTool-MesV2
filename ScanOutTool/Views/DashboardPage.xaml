<Page x:Class="ScanOutTool.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Dashboard"
      Background="{DynamicResource MaterialDesignPaper}">
    <Page.Resources>
        <Style x:Key="SurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="CompactValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="ShopFloorInfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>

        <Style x:Key="ShopFloorPrimaryInfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="LargeResultStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontSize" Value="120"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="OK">
                    <Setter Property="Foreground" Value="#39D353"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="NG">
                    <Setter Property="Foreground" Value="#FF4D4D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HmesResultStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HmesResult}" Value="OK">
                    <Setter Property="Foreground" Value="#39D353"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HmesResult}" Value="NG">
                    <Setter Property="Foreground" Value="#FF4D4D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReadOnlyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="ShopFloorMessageBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Result}" Value="OK">
                    <Setter Property="Foreground" Value="#39D353"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Result}" Value="NG">
                    <Setter Property="Foreground" Value="#FF4D4D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HmesMessageBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HmesResult}" Value="OK">
                    <Setter Property="Foreground" Value="#39D353"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HmesResult}" Value="NG">
                    <Setter Property="Foreground" Value="#FF4D4D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SurfaceStyle}" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SelectedEBR}"
                         Width="180"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Selected EBR/WO"
                         Margin="0,0,10,0"/>

                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding SelectedRunMode}"
                          ItemsSource="{Binding RunModes}"
                          Width="165"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                          materialDesign:HintAssist.Hint="Run Mode"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">                    
                    <Button Content="{Binding StartBtnText}"
                            Command="{Binding StartCommand}"
                            MinWidth="120"
                            Height="42"
                            FontWeight="SemiBold"
                            IsEnabled="{Binding IsSessionStarting, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.18*"/>
                <ColumnDefinition Width="0.82*"/>
            </Grid.ColumnDefinitions>          

            <Border Grid.Column="0" Style="{StaticResource SurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MonitorDashboard" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ShopFloor Data" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ShopFloorClearCommand}"
                                    Height="36"
                                    MinWidth="92"
                                    Padding="12,0"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="CLEAR"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ShopFloorTraceCommand}"
                                    Height="36"
                                    MinWidth="92"
                                    Padding="12,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="History" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="TRACE"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="3" Rows="1" Margin="0,14,0,8">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="PID" Style="{StaticResource CaptionStyle}"/>
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Left"
                                     MaxHeight="30">
                                <TextBlock Text="{Binding PID}" Style="{StaticResource ShopFloorInfoValueStyle}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Part No" Style="{StaticResource CaptionStyle}"/>
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Left"
                                     MaxHeight="40">
                                <TextBlock Text="{Binding PartNo}" Style="{StaticResource ShopFloorPrimaryInfoValueStyle}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Work Order" Style="{StaticResource CaptionStyle}"/>
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Left"
                                     MaxHeight="40">
                                <TextBlock Text="{Binding WorkOrder}" Style="{StaticResource ShopFloorPrimaryInfoValueStyle}"/>
                            </Viewbox>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform"
                                 StretchDirection="Both"
                                 HorizontalAlignment="Center"
                                 MaxHeight="200">
                            <TextBlock Text="{Binding Result}" Style="{StaticResource LargeResultStyle}"/>
                        </Viewbox>
                        <StackPanel HorizontalAlignment="Center" Margin="0,-8,0,4">                           
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     MaxHeight="40"
                                     HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Progress}"
                                           Foreground="{DynamicResource MaterialDesignBody}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Viewbox>
                        </StackPanel>
                    </StackPanel>

                    <TextBox Grid.Row="3"
                             Text="{Binding ResultMessage}"
                             materialDesign:HintAssist.Hint="ShopFloor Message"
                             Style="{StaticResource ShopFloorMessageBoxStyle}"
                             Height="72"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Web" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="HMES Web Data" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ManualPrintCommand}"
                                Height="36"
                                MinWidth="126"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Manual Print"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Result" Style="{StaticResource CaptionStyle}"/>
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Left"     
                                     VerticalAlignment="Stretch"
                                     MaxHeight="80">
                                <TextBlock Text="{Binding HmesResult}" Style="{StaticResource HmesResultStyle}"/>
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sending" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding IsDataSending}" Style="{StaticResource CompactValueStyle}"/>
                            <TextBlock Text="Run Mode" Style="{StaticResource CaptionStyle}" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding SelectedRunMode}" Style="{StaticResource CompactValueStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pack Qty" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding HmesPackQty}"
                                       Style="{StaticResource ValueStyle}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"/>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Magazine QPM" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding HmesMagazineQty}"
                                       Style="{StaticResource ValueStyle}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Magazine No" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="{Binding HmesMagazineNo}"
                                       Style="{StaticResource CompactValueStyle}"
                                       HorizontalAlignment="Left"
                                       TextAlignment="Left"/>
                        </Grid>

                        
                    </Grid>
                    <Grid Grid.Row="3">
                         <TextBox
                         Text="{Binding HmesMessage}"
                         materialDesign:HintAssist.Hint="HMES Message"
                         Style="{StaticResource HmesMessageBoxStyle}"
                         Height="72"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SurfaceStyle}" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Logs" Style="{StaticResource SectionTitleStyle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding Logs}"
                             TextWrapping="NoWrap"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             BorderThickness="0"
                             MinHeight="30"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Visible"
                             TextChanged="LogTextBox_TextChanged"
                             VerticalContentAlignment="Top"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"/>
                    <Border Visibility="{Binding IsMessageOn, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#EE333333"
                            BorderBrush="#FFFFD000"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            VerticalAlignment="Top"
                            Margin="10"
                            MinHeight="72">
                        <TextBlock Text="{Binding InformationMessage}"
                                   Foreground="Yellow"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
