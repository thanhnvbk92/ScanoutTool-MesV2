<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>F:\Dev\Software\Publish\ScanOutTool_MESV2</PublishDir>
    <PublishZipFile>F:\Dev\Software\Update Zip Files\ScanOutTool_MESV2.zip</PublishZipFile>
    <UpdateInfoFile>F:\Dev\Software\Update_ScanOutTool_MESV2.xml</UpdateInfoFile>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
